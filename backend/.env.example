# Copiar a .env y ajustar valores.
# Al correr con docker compose, DATABASE_URL se sobreescribe con el host "db"
# (ver docker-compose.yml). Este valor es para correr el backend localmente
# (fuera de Docker) contra la db en Docker (localhost:5432).
DATABASE_URL="postgresql://myn:myn@localhost:5432/myn_db?schema=public"

JWT_SECRET="cambiar-este-secreto-en-produccion"
JWT_EXPIRES_IN="1d"

PORT=3000

# CORS: origen del frontend en desarrollo (Vite)
FRONTEND_URL="http://localhost:5173"
